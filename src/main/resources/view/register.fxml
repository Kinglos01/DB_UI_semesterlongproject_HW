<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="355.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewmodel.RegisterController">
   <children>
      <TextField fx:id="regFirst" layoutX="40.0" layoutY="110.0" onKeyTyped="#regFirstTyped" prefHeight="26.0" prefWidth="265.0" promptText="First Name" />
      <TextField fx:id="regLast" layoutX="40.0" layoutY="160.0" onKeyTyped="#regLastTyped" prefHeight="26.0" prefWidth="265.0" promptText="Last Name" />
      <TextField fx:id="regEmail" layoutX="40.0" layoutY="210.0" onKeyTyped="#regEmailTyped" prefHeight="26.0" prefWidth="265.0" promptText="Email" />
      <TextField fx:id="regPassword" layoutX="40.0" layoutY="260.0" onKeyTyped="#regPasswordTyped" prefHeight="26.0" prefWidth="265.0" promptText="Password" />
      <Label layoutX="40.0" layoutY="58.0" text="Please fill out the information below">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button fx:id="addAcct" disable="true" layoutX="14.0" layoutY="350.0" mnemonicParsing="false" onAction="#addAccountPressed" text="Add Account" />
      <TextField fx:id="regVerify" layoutX="40.0" layoutY="310.0" onKeyTyped="#regVerifyTyped" prefHeight="26.0" prefWidth="265.0" promptText="Verify Password" />
      <Label fx:id="regNoti" layoutX="160.0" layoutY="350.0" prefHeight="15.0" prefWidth="28.0" visible="false">
         <font>
            <Font size="12.0" />
         </font>
      </Label>
      <Button fx:id="returnBtn" layoutX="236.0" layoutY="350.0" mnemonicParsing="false" onAction="#regGoBack" text="Return to sign in" />
   </children>
</AnchorPane>
